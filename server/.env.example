# Environment
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgi_erp?schema=public"

# JWT
# Obrigatório em produção, mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Redis (for cache and real-time)
REDIS_URL="redis://localhost:6379"

# CORS (frontend URL)
FRONTEND_URL="http://localhost:3000"

# --- Segurança e contas ---
# Várias origens separadas por vírgulas (ex.: produção + pré-visualizações)
# FRONTEND_URL="https://sgiserviteng-web.onrender.com"
# URL pública desta API (redirect_uri do Google/Microsoft)
PUBLIC_API_URL="http://localhost:3001"
# Emails que entram como ADMIN ao usar "Entrar com Google" (email verificado)
ADMIN_EMAILS=""
# Domínios cujos emails verificados (Google) entram logo como Funcionário
ALLOWED_EMAIL_DOMAINS=""

# --- Login Google (console.cloud.google.com → APIs & Services → Credentials) ---
# Redirect URI: ${PUBLIC_API_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Login Microsoft (portal.azure.com → Entra ID → App registrations) ---
# Redirect URI (Web): ${PUBLIC_API_URL}/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" (contas pessoais e empresariais), "organizations" ou o ID do tenant da empresa
MICROSOFT_TENANT_ID="common"
